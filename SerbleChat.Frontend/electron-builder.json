{
  "appId": "net.serble.chat",
  "productName": "Serble Chat",
  "artifactName": "serble-chat-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "dist-electron",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!electron/adhoc-sign.cjs",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "afterPack": "electron/adhoc-sign.cjs",
  "publish": null,
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "public/icons/512.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "serble-chat-${version}-windows-${arch}-setup.${ext}"
  },
  "portable": {
    "artifactName": "serble-chat-${version}-windows-${arch}-portable.${ext}"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "public/icons/512.png",
    "category": "public.app-category.social-networking",
    "artifactName": "serble-chat-${version}-macos-${arch}.${ext}"
  },
  "linux": {
    "target": [{ "target": "tar.xz", "arch": ["x64"] }],
    "icon": "public/icons/512.png",
    "category": "Network;InstantMessaging",
    "artifactName": "serble-chat-${version}-linux-${arch}.${ext}"
  }
}
